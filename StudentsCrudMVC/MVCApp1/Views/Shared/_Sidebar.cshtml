<nav id="sidebarMenu" class="col-md-3 col-lg-2 col-4 sidebar bg-light">
	<div class="position-sticky pt-3">
		<ul class="nav flex-column">

			<!-- Generates Sidebar Link Button -->

			@helper LinkGenerator(string text, string iconName, string href)
			{
				<li class="nav-item">
					<a class="nav-link" aria-current="page" href="@href">
						<i class="bi bi-@iconName-fill fs-5"></i>
						@text
					</a>
				</li>
			}

			@LinkGenerator("Home Page", "house", Url.Action("Index", "Students"))

		</ul>
	</div>
</nav>